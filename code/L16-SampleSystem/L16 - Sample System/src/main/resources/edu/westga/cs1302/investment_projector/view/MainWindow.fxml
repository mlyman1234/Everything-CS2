<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane minHeight="298.0" minWidth="340.0" prefHeight="298.0" prefWidth="452.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.investment_projector.view.MainWindow">
   <children>
      <TextField fx:id="name" layoutX="140.0" layoutY="30.0" />
      <Button fx:id="addingName" layoutX="14.0" layoutY="30.0" mnemonicParsing="false" onAction="#addName" text="Add Name" />
      <ListView fx:id="collectionOfNames" layoutX="126.0" layoutY="84.0" prefHeight="200.0" prefWidth="200.0">
         <contextMenu>
            <ContextMenu>
              <items>
                <MenuItem mnemonicParsing="false" text="Unspecified Action" />
              </items>
            </ContextMenu>
         </contextMenu>
      </ListView>
      <Button fx:id="removingName" layoutX="329.0" layoutY="30.0" mnemonicParsing="false" onAction="#removeName" text="Remove Name" />
   </children>
</AnchorPane>
